# Copy to .env.local for local development. Never commit a real .env file.
# No Supabase project exists yet (that is M0-P2); these are placeholders so the
# shape of the config is visible ahead of time. Do not fill in real values here.

# Supabase (set once M0-P2 provisions a project)
VITE_SUPABASE_URL=https://example-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key

# Server-side only (Edge Functions / CI secrets) — NEVER prefix with VITE_,
# NEVER put in the client bundle, NEVER commit a real value.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-server-side-only
