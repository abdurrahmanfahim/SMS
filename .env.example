# Copy to .env.local for local development. Never commit a real .env file.
# Every value below is a placeholder. Real values live in GitHub Actions secrets (CI) or in the
# Owner's shell (see docs/runbooks/deploy.md, "Where each secret lives").

# Supabase, client side. Both are public by design (RLS protects the data); they are baked into
# the web build. Set them in the static host's build environment and in GitHub Actions secrets.
VITE_SUPABASE_URL=https://example-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key

# Server side only (Owner's shell for `pnpm seed:staging`, CI secrets for migrations).
# NEVER prefix with VITE_, NEVER put in the client bundle, NEVER commit a real value.
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-server-side-only

# Staging e2e (GitHub Actions secrets only): the deployed URL and the seeded users' credentials
# printed once by `pnpm seed:staging`.
STAGING_URL=https://example-staging.pages.dev
E2E_STAGING_SINGLE_EMAIL=replace-with-seeded-single-membership-user-email
E2E_STAGING_SINGLE_PASSWORD=replace-with-generated-password
E2E_STAGING_MULTI_EMAIL=replace-with-seeded-two-membership-user-email
E2E_STAGING_MULTI_PASSWORD=replace-with-generated-password
E2E_STAGING_OTHER_EMAIL=replace-with-seeded-user-in-the-other-institution-email
E2E_STAGING_OTHER_PASSWORD=replace-with-generated-password
