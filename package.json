{
  "name": "sms",
  "private": true,
  "version": "0.0.0",
  "description": "Bangla-first school management system for schools, madrasas and coaching centres in Bangladesh.",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json}\" \"packages/**/*.{ts,tsx,js,jsx,json}\" \"e2e/**/*.{ts,tsx,js,jsx,json}\" \"docs/decisions/*.md\" \"package.json\" \"turbo.json\" \"pnpm-workspace.yaml\" \".prettierrc.json\" \"tsconfig*.json\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json}\" \"packages/**/*.{ts,tsx,js,jsx,json}\" \"e2e/**/*.{ts,tsx,js,jsx,json}\" \"docs/decisions/*.md\" \"package.json\" \"turbo.json\" \"pnpm-workspace.yaml\" \".prettierrc.json\" \"tsconfig*.json\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3"
  }
}
