{
  "$schema": "./tools/design-tokens.schema.json",
  "meta": {
    "name": "SMS design tokens v0",
    "version": "0.1.0",
    "note": "Munshi's own Tailwind/CSS token values were not shared with this task (docs/research/munshi-flow-analysis.md records the direction — gold accent, deep primary — but not exact hex values). The palette below is this task's own choice, in that spirit, with every contrast ratio computed by docs/spec/tools/check-contrast.mjs rather than judged by eye. See docs/spec/design-system.md §7 for the keep/change/drop mapping."
  },
  "breakpoints": {
    "sm": "360px",
    "md": "768px",
    "lg": "1280px"
  },
  "color": {
    "light": {
      "surface": {
        "base": "#FFFFFF",
        "subtle": "#F3F4F6",
        "raised": "#FFFFFF"
      },
      "text": {
        "primary": "#111827",
        "secondary": "#374151",
        "disabled": "#9CA3AF",
        "inverse": "#FFFFFF"
      },
      "border": {
        "default": "#D1D5DB",
        "strong": "#6B7280"
      },
      "primary": {
        "base": "#0F6E51",
        "hover": "#0B5A42",
        "fg": "#FFFFFF"
      },
      "accent": {
        "base": "#C9960C",
        "hover": "#A97E0A",
        "fg": "#3B2400"
      },
      "success": {
        "base": "#15803D",
        "fg": "#FFFFFF"
      },
      "warning": {
        "base": "#B45309",
        "fg": "#FFFFFF"
      },
      "danger": {
        "base": "#B91C1C",
        "fg": "#FFFFFF"
      },
      "info": {
        "base": "#1D4ED8",
        "fg": "#FFFFFF"
      },
      "link": {
        "base": "#0F6E51"
      },
      "focusRing": {
        "base": "#0F6E51"
      }
    },
    "dark": {
      "surface": {
        "base": "#0B1220",
        "subtle": "#131B2E",
        "raised": "#182238"
      },
      "text": {
        "primary": "#F3F4F6",
        "secondary": "#CBD5E1",
        "disabled": "#6B7280",
        "inverse": "#0B1220"
      },
      "border": {
        "default": "#263047",
        "strong": "#64748B"
      },
      "primary": {
        "base": "#34D399",
        "hover": "#10B981",
        "fg": "#052E1F"
      },
      "accent": {
        "base": "#FBBF24",
        "hover": "#F59E0B",
        "fg": "#3B2400"
      },
      "success": {
        "base": "#34D399",
        "fg": "#052E1F"
      },
      "warning": {
        "base": "#FBBF24",
        "fg": "#3B2400"
      },
      "danger": {
        "base": "#F87171",
        "fg": "#450A0A"
      },
      "info": {
        "base": "#7DD3FC",
        "fg": "#0B1220"
      },
      "link": {
        "base": "#7DD3FC"
      },
      "focusRing": {
        "base": "#FBBF24"
      }
    }
  },
  "contrastPairs": [
    {
      "fg": "text.primary",
      "bg": "surface.base",
      "kind": "text"
    },
    {
      "fg": "text.secondary",
      "bg": "surface.base",
      "kind": "text"
    },
    {
      "fg": "text.disabled",
      "bg": "surface.base",
      "kind": "text",
      "required": false
    },
    {
      "fg": "primary.fg",
      "bg": "primary.base",
      "kind": "text"
    },
    {
      "fg": "accent.fg",
      "bg": "accent.base",
      "kind": "text"
    },
    {
      "fg": "success.fg",
      "bg": "success.base",
      "kind": "text"
    },
    {
      "fg": "warning.fg",
      "bg": "warning.base",
      "kind": "text"
    },
    {
      "fg": "danger.fg",
      "bg": "danger.base",
      "kind": "text"
    },
    {
      "fg": "info.fg",
      "bg": "info.base",
      "kind": "text"
    },
    {
      "fg": "link.base",
      "bg": "surface.base",
      "kind": "text"
    },
    {
      "fg": "border.strong",
      "bg": "surface.base",
      "kind": "ui"
    },
    {
      "fg": "focusRing.base",
      "bg": "surface.base",
      "kind": "ui"
    },
    {
      "fg": "primary.base",
      "bg": "surface.base",
      "kind": "ui"
    },
    {
      "fg": "accent.base",
      "bg": "surface.base",
      "kind": "ui",
      "required": false
    }
  ],
  "typeScale": {
    "note": "rem, base 16px root. Bangla script (Hind Siliguri / Noto Sans Bengali) needs more vertical room for matras and conjuncts than Latin, so lineHeight is a multiplier applied to the Bangla-first stack, not a fixed px value; see design-system.md §1.",
    "xs": {
      "size": "0.75rem",
      "lineHeight": 1.6
    },
    "sm": {
      "size": "0.875rem",
      "lineHeight": 1.6
    },
    "base": {
      "size": "1rem",
      "lineHeight": 1.65
    },
    "lg": {
      "size": "1.125rem",
      "lineHeight": 1.6
    },
    "xl": {
      "size": "1.25rem",
      "lineHeight": 1.55
    },
    "2xl": {
      "size": "1.5rem",
      "lineHeight": 1.5
    },
    "3xl": {
      "size": "1.875rem",
      "lineHeight": 1.4
    },
    "4xl": {
      "size": "2.25rem",
      "lineHeight": 1.3
    }
  },
  "spacing": {
    "0": "0px",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem"
  },
  "radius": {
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "full": "9999px"
  },
  "elevation": {
    "note": "Dark theme uses a lighter border instead of a darker shadow, since shadows barely read on a dark surface; see design-system.md §2.",
    "light": {
      "sm": "0 1px 2px 0 rgb(17 24 39 / 0.06)",
      "md": "0 4px 8px -2px rgb(17 24 39 / 0.10)",
      "lg": "0 12px 24px -4px rgb(17 24 39 / 0.14)"
    },
    "dark": {
      "sm": "0 0 0 1px rgb(255 255 255 / 0.06)",
      "md": "0 0 0 1px rgb(255 255 255 / 0.09)",
      "lg": "0 0 0 1px rgb(255 255 255 / 0.12)"
    }
  },
  "motion": {
    "duration": {
      "fast": "100ms",
      "base": "180ms",
      "slow": "280ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)",
      "accelerate": "cubic-bezier(0.3, 0, 1, 1)"
    },
    "reducedMotion": {
      "rule": "@media (prefers-reduced-motion: reduce)",
      "policy": "Disable all non-essential motion: no slide/scale/parallax transitions. Keep only opacity cross-fades capped at duration.fast (100ms), and skip animation entirely for anything longer. Loading spinners may keep rotating (essential, communicates state) but must not be the only signal of progress — pair with text per ux-standard.md."
    }
  },
  "zIndex": {
    "base": 0,
    "stickyHeader": 10,
    "dropdown": 20,
    "bottomSheet": 30,
    "modal": 40,
    "toast": 50,
    "tooltip": 60
  }
}
