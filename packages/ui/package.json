{
  "name": "@sms/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint . && node scripts/generate-tokens.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false --noEmit false --outDir dist",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@sms/config": "workspace:*",
    "@types/react": "^19.0.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "eslint": "^9.11.1",
    "react": "^19.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/styles/tokens.css",
    "./tailwind-preset": "./tailwind-preset.js"
  }
}
