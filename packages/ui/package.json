{
  "name": "@sms/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint . && node scripts/generate-tokens.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false --noEmit false --outDir dist",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@sms/config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.11.1",
    "jsdom": "^30.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/styles/tokens.css",
    "./tailwind-preset": "./tailwind-preset.js"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.23",
    "lucide-react": "^1.48.0"
  }
}
