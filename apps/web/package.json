{
  "name": "@sms/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/bundle-budget.mjs",
    "preview": "vite preview",
    "lint": "eslint . && node scripts/i18n-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "budget": "node scripts/bundle-budget.mjs"
  },
  "dependencies": {
    "@fontsource/hind-siliguri": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@sms/db": "workspace:*",
    "lucide-react": "^1.48.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@sms/config": "workspace:*",
    "@sms/domain": "workspace:*",
    "@sms/ui": "workspace:*",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.11.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.1"
  }
}
